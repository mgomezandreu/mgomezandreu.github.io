---
import { withBase } from "@lib/utils";

type Props = {
  src?: string;
  alt: string;
};

const { src, alt } = Astro.props;
---

{/* Fixed-size box keeps every mark the same visual weight and the text column
    aligned. Multiply blending drops white logo backgrounds into the paper.
    Without a logo, the alt text stands in as a short mark. */}
<span class="chip">
  {src
    ? <img src={withBase(src)} alt={alt} loading="lazy" decoding="async" />
    : <span class="mark caps">{alt}</span>}
</span>

<style>
  .chip {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 40px;
  }
  img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .mark {
    font-size: 15px;
    letter-spacing: 0.06em;
    color: var(--quiet);
  }
</style>
